# Copiez ce fichier en config.properties et renseignez vos valeurs.
# config.properties n'est PAS versionne : il porte un mot de passe.
#
# Le role est votre role applicatif. C'est tout l'interet de
# l'avoir cree : le programme ne se connecte pas avec un compte qui peut tout
# faire.
#
# Adaptez le nom de la base et celui du role a ce que vos scripts SQL creent.

db.url=jdbc:postgresql://localhost:5432/trombifunscope
db.user=
db.password=
